{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(Get-Process -Name \"java\" -ErrorAction SilentlyContinue | Select-Object Id, ProcessName, StartTime, @{N='CmdLine';E={\\(Get-CimInstance Win32_Process -Filter \"ProcessId=$\\($_.Id\\)\"\\).CommandLine}} | Format-List)",
      "PowerShell(Stop-Process -Id 75572 -Force -ErrorAction SilentlyContinue)",
      "PowerShell(Stop-Process -Id 74468 -Force -ErrorAction SilentlyContinue)",
      "PowerShell(Get-Process -Id 74468,75572 -ErrorAction SilentlyContinue)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-todo-append.mjs"
          }
        ]
      }
    ]
  }
}
