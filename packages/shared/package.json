{
  "name": "@biblequize/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types, constants, logic, and i18n keys between web + mobile apps",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./constants": {
      "types": "./src/constants/index.ts",
      "default": "./src/constants/index.ts"
    },
    "./logic": {
      "types": "./src/logic/index.ts",
      "default": "./src/logic/index.ts"
    },
    "./i18n-keys": {
      "types": "./src/i18n-keys/index.ts",
      "default": "./src/i18n-keys/index.ts"
    }
  },
  "sideEffects": false
}
