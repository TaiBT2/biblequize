# ═══════════════════════════════════════════════════════════════════
# Mobile env config (cp .env.example .env, rồi fill values)
# ═══════════════════════════════════════════════════════════════════

# API backend URL.
# - Local dev Android emulator: http://10.0.2.2:8080 (auto via getBaseURL)
# - Local dev iOS simulator: http://localhost:8080 (auto)
# - Production: https://be.forbible.org (mặc định khi không set)
EXPO_PUBLIC_API_URL=http://localhost:8080

# ═══════════════════════════════════════════════════════════════════
# Google OAuth (Google Sign-In)
# Setup guide: docs/dev/mobile-google-auth-setup.md
# ═══════════════════════════════════════════════════════════════════
# Google Cloud Console > APIs & Services > Credentials > Create OAuth 2.0 Client ID
# Tạo 3 client IDs riêng (1 per platform):

# 1. Web client — bắt buộc, dùng cho Expo Go dev + backend ID token verify
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# 2. Android client — required cho EAS Build standalone APK
#    Application type: Android
#    Package name: com.biblequiz.app (match android.package trong app.json)
#    SHA-1: chạy `eas credentials` → Android → Production keystore → copy SHA-1
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# 3. iOS client — required cho EAS Build standalone IPA / TestFlight
#    Application type: iOS
#    Bundle ID: com.biblequiz.app (match ios.bundleIdentifier trong app.json)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# ═══════════════════════════════════════════════════════════════════
# Sentry mobile (S2-3). Leave empty → Sentry no-op (safe cho local dev).
# DSN từ Sentry project settings → Client Keys → React Native SDK.
# ═══════════════════════════════════════════════════════════════════
EXPO_PUBLIC_SENTRY_DSN=

# Env tag cho Sentry events. eas.json profile sẽ override (development/preview/production).
# Local dev = "development".
EXPO_PUBLIC_ENV=development
