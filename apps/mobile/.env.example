EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Sentry mobile (S2-3). Leave empty → Sentry no-op (safe cho local dev).
# DSN từ Sentry project settings → Client Keys → React Native SDK.
EXPO_PUBLIC_SENTRY_DSN=

# Env tag cho Sentry events. eas.json profile sẽ override (development/preview/production).
# Local dev = "development".
EXPO_PUBLIC_ENV=development
