{
  "name": "biblequiz-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:local": "vite --mode development --host",
    "dev:network": "vite --mode development --host 0.0.0.0",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:capacitor": "vite build --mode capacitor",
    "cap:sync": "pnpm run build:capacitor && cap sync",
    "cap:android": "pnpm run cap:sync && cap open android",
    "cap:run:android": "pnpm run cap:sync && cap run android",
    "preview": "vite preview",
    "preview:dev": "vite preview --mode development",
    "lint": "eslint . --max-warnings=9999",
    "lint:fix": "eslint . --fix --max-warnings=9999",
    "lint:errors-only": "eslint . --quiet",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/e2e.mjs local",
    "test:e2e:dev": "node scripts/e2e.mjs dev",
    "test:e2e:prod": "node scripts/e2e.mjs prod --grep @smoke",
    "test:e2e:headed": "node scripts/e2e.mjs local --headed",
    "test:e2e:report": "playwright show-report playwright-report/local",
    "test:e2e:report:dev": "playwright show-report playwright-report/dev",
    "test:e2e:report:prod": "playwright show-report playwright-report/prod",
    "validate:i18n": "node scripts/validate-i18n.mjs"
  },
  "dependencies": {
    "@biblequize/shared": "workspace:*",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.3.25",
    "@stomp/stompjs": "^7.0.0",
    "@tanstack/react-query": "^5.56.2",
    "axios": "^1.7.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^6.23.0",
    "sockjs-client": "^1.6.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.11.30",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "happy-dom": "^20.8.9",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.32",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.5",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
