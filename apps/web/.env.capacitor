# Capacitor (mobile app) build environment.
# The app has NO same-origin backend — API/WS MUST be absolute URLs.
# Update if the production API domain changes (e.g. after forbible.org rebrand).
VITE_TARGET=capacitor
VITE_API_BASE_URL=https://be.forbible.org
VITE_WS_URL=wss://be.forbible.org/ws

# Native Google Sign-In: serverClientId = the existing Web OAuth client id.
# MobileAuthService verifies idToken against this audience (see MOB-0a).
VITE_GOOGLE_CLIENT_ID=599482670828-1og1pabg41r6a1c5aod5cihji03ergru.apps.googleusercontent.com

VITE_DEBUG=false
VITE_LOG_LEVEL=error
VITE_ENABLE_DEV_TOOLS=false
VITE_ENABLE_MOCK_DATA=false
